# Server & Runtime Configuration
PORT=3000

# Local Ethereum Blockchain (Hardhat Node)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# Deployed LandRegistry Smart Contract (populated automatically by scripts/deploy.js)
CONTRACT_ADDRESS=
ADMIN_ADDRESS=

# Frontend Public Network Config (Vite)
VITE_CHAIN_ID=31337
VITE_CONTRACT_ADDRESS=

# SQLite Database (relative to backend/prisma/schema.prisma)
DATABASE_URL=file:./landchain.db

# Off-Chain Document Storage Vault
UPLOAD_DIR=./backend/storage/uploads
